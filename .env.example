# API Gateway URL (Backend microservices)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Default Locale
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dfs07oaet

# ============================================================
# Cấu hình Đăng nhập Google (AUTH-02)
# ============================================================
# Bật hiển thị nút đăng nhập Google trên Frontend (true / false)
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false

# Google OAuth 2.0 Web Client ID (dạng: xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com)
# Phải trùng khớp 100% với GOOGLE_CLIENT_ID phía backend
# LƯU Ý BẢO MẬT: TUYỆT ĐỐI KHÔNG ĐƯỢC ĐẶT CLIENT SECRET VÀO ĐÂY HOẶC BẤT KỲ BIẾN NEXT_PUBLIC_* NÀO.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

