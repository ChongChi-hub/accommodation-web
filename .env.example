# ============================================================
# accommodation-web Environment Configuration (.env.example)
# Copy to .env.local for local dev or configure on VPS / GitHub
# NEVER commit .env or .env.local to Git!
# ============================================================

# Public App Domain & API Gateway URL
NEXT_PUBLIC_APP_URL=https://cozynestvvip.duckdns.org
NEXT_PUBLIC_API_URL=https://cozynestvvip.duckdns.org/api/v1
INTERNAL_API_URL=http://api-gateway:8080/api/v1

# Default Locale
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# Cloudinary Media Uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET

# Google OAuth 2.0 Web Client ID (must match backend GOOGLE_CLIENT_ID; NEVER put Client Secret here)
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# EmailJS Server-Only OTP Configuration (NEVER prefix with NEXT_PUBLIC_)
EMAILJS_ACC1_SERVICE_ID=REPLACE_WITH_ACC1_SERVICE_ID
EMAILJS_ACC1_PUBLIC_KEY=REPLACE_WITH_ACC1_PUBLIC_KEY
EMAILJS_ACC1_PRIVATE_KEY=REPLACE_WITH_ACC1_PRIVATE_KEY
EMAILJS_TEMPLATE_REGISTER=REPLACE_WITH_REGISTER_TEMPLATE_ID
EMAILJS_TEMPLATE_VERIFY_EMAIL=REPLACE_WITH_VERIFY_EMAIL_TEMPLATE_ID
EMAILJS_ACC2_SERVICE_ID=REPLACE_WITH_ACC2_SERVICE_ID
EMAILJS_ACC2_PUBLIC_KEY=REPLACE_WITH_ACC2_PUBLIC_KEY
EMAILJS_ACC2_PRIVATE_KEY=REPLACE_WITH_ACC2_PRIVATE_KEY
EMAILJS_TEMPLATE_CHANGE_PASSWORD=REPLACE_WITH_CHANGE_PASSWORD_TEMPLATE_ID
